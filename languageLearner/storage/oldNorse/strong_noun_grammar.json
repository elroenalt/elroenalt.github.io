[
    ["mainTitle", "Strong Nouns and Case Introduction"],
    ["container", [
        ["title", "Genders and Cases"],
        ["title", "Genders:"],
        ["text", "<ul><li>Neuter, (typical) ending -_ and a 'a'</li><li> Feminin, (typical) ending -_ and a 'ǫ'</li><li> Masculine, (typical) ending -r </li></ul>"],
        ["title", "Cases:"],
        ["table", [
            [false,{"text":"<b>explanation</b>","color":"gray"},{"text":"<b>example</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"Who/what is (verb)ing?","color":"transparent"},{"text":"<b>I</b> gave Terry's clinic a donation","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"Who/what did (the subject) (verb)?","color":"transparent"},{"text":"I gave Terry's clinic a <b>donation</b>","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"Whose?","color":"transparent"},{"text":"I gave <b>Terry's</b> clinic a donation","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"To who/what?","color":"transparent"},{"text":"I gave Terry's <b>clinic</b> a donation","color":"transparent"}]
        ]]
    ],true],

    ["container", [
        ["title", "Generall Rules"],
        ["text", "Any 'j' before a 'i' will generally be removed (herjið -> herið), tho some writers leave it for regulatiy's sake."],
        ["text", "If there are three consonants in a row, drop the middle one ('ndd' -> 'nd')."],
        ["text", "If a 'd' or a 't' is behind a 'ð', the 'ð' becomes respectifly become a dobble consonants ('ðt' -> 'tt')"],
        ["text", "Any 'áa' will collapse to 'á'."],
        ["text", "A 'r' is likely to assimilate with a 'n','l' or 's' if it is not added to a root sylable and ends in more than one consonants"],
        ["text", "The vowel of the second sylable in a three sylable word will be dropped if the word is still pronouncable."],
        ["container", [
            ["title", "U-Mutation"],
            ["text", "Any time a 'u' in an unstressed syllable follows an 'a' in a stressed syllable. It changes 'a' to 'ǫ'.<br>May also appier when there used to be a 'u' in place.<br>When there is an unstressed sylable before the stressed a, the unstressed'a' additionaly mutates into 'u'."]
        ],false],
        ["container", [
            ["title", "I-Mutation"],
            ["text", "<div>'a' -> 'e'<br>'á' -> 'æ'<br>'o' -> 'ø'/'e'/'y'<br>'ó' -> 'ố'<br>'u' -> 'y'<br>'ú' -> 'ý'<br>'jó' -> 'ý'<br>'jú' -> 'ý'<br>'ǫ' -> 'ø'<br>'au' -> 'ey'</div>"]
        ],false]
    ],false],

    ["container", [
        ["title", "Typical Neuter Nouns"],
        ["text", "textbook form in Nominative -> typicall ending = -_"],
        ["table", [
            [false,{"text":"<b>Singular</b>","color":"gray"},{"text":"<b>Plural</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"-_","color":"transparent"},{"text":"-_ (U-Mutation)","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"-_","color":"transparent"},{"text":"-_ (U-Mutation)","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"-s","color":"transparent"},{"text":"-a","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"-i","color":"transparent"},{"text":"-um","color":"transparent"}]
        ]],
        ["text", "Example: vatn (water) -> vatn : haf (ocean) -> haf"],
        ["table", [
            [false,{"text":"<b>Singular</b>","color":"gray"},{"text":"<b>Plural</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"vatn : haf","color":"transparent"},{"text":"vǫtn : hǫf","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"vatn : haf","color":"transparent"},{"text":"vǫtn : hǫf","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"vatn : hafs","color":"transparent"},{"text":"vatna : hafa","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"vatni : hafi","color":"transparent"},{"text":"vǫtnum : hǫfum","color":"transparent"}]
        ]]
    ],false],
    
    ["container", [
        ["title", "Typical Feminine Nouns"],
        ["text", "textbook form in Nominative -> instead of 'a', a 'ǫ' because of U-Mutation"],
        ["table", [
            [false,{"text":"<b>Singular</b>","color":"gray"},{"text":"<b>Plural</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"-_ (U-Mutation)","color":"transparent"},{"text":"-ir","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"-_ (U-Mutation)","color":"transparent"},{"text":"-ir","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"-ar","color":"transparent"},{"text":"-a","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"-(u)","color":"transparent"},{"text":"-um","color":"transparent"}]
        ]],
        ["text", "Example: jǫrð (earth) -> jǫrð : ætt (family,direction) -> ætt"],
        ["table", [
            [false,{"text":"<b>Singular</b>","color":"gray"},{"text":"<b>Plural</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"jǫrð : ætt","color":"transparent"},{"text":"jarðir : ættir","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"jǫrð : ætt","color":"transparent"},{"text":"jarðir : ættir","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"jarðar : ættar","color":"transparent"},{"text":"jarða : ætta","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"jǫrð(u) : ætt(u)","color":"transparent"},{"text":"jǫrðum : ættum","color":"transparent"}]
        ]]
    ],false],

    ["container", [
        ["title", "Typical Masculine Nouns"],
        ["text", "textbook form in Nominative -> typicall ending = -r"],
        ["text", "Remove -R before adding case endings."],
        ["table", [
            [false,{"text":"<b>Singular</b>","color":"gray"},{"text":"<b>Plural</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"-r","color":"transparent"},{"text":"-ar","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"-_","color":"transparent"},{"text":"-a","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"-s","color":"transparent"},{"text":"-a","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"-i","color":"transparent"},{"text":"-um","color":"transparent"}]
        ]],
        ["text", "Example: edlr (fire) -> eld_ : vindr (wind) -> vind"],
        ["table", [
            [false,{"text":"<b>Singular</b>","color":"gray"},{"text":"<b>Plural</b>","color":"gray"}],
