            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"elds : vinds","color":"transparent"},{"text":"elda : vinda","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"eldi : vindi","color":"transparent"},{"text":"eldum : vindum","color":"transparent"}]
