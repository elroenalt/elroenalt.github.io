            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"-a","color":"transparent"},{"text":"-na","color":"transparent"}],
            [{"text":"<b>Dative</b>","color":"gray"},{"text":"-a","color":"transparent"},{"text":"-um","color":"transparent"}]
