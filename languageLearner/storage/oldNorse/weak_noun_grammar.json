[
    ["mainTitle", "Strong Nouns and Case Introduction"],
    ["container", [
        ["title", "Cases"],
        ["title", "Cases:"],
        ["table", [
            [false,{"text":"<b>explanation</b>","color":"gray"},{"text":"<b>example</b>","color":"gray"}],
            [{"text":"<b>Nominative</b>","color":"gray"},{"text":"Who/what is (verb)ing?","color":"transparent"},{"text":"<b>I</b> gave Terry's clinic a donation","color":"transparent"}],
            [{"text":"<b>Accusative</b>","color":"gray"},{"text":"Who/what did (the subject) (verb)?","color":"transparent"},{"text":"I gave Terry's clinic a <b>donation</b>","color":"transparent"}],
            [{"text":"<b>Genitive</b>","color":"gray"},{"text":"Whose?","color":"transparent"},{"text":"I gave <b>Terry's</b> clinic a donation","color":"transparent"}],
