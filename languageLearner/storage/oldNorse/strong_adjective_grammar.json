    ["container", [
        ["title", "Generall Rules"],
        ["text", "Any 'j' before a 'i' will generally be removed (herjið -> herið), tho some writers leave it for regulatiy's sake."],
        ["text", "If there are three consonants in a row, drop the middle one ('ndd' -> 'nd')."],
        ["text", "If a 'd' or a 't' is behind a 'ð', the 'ð' becomes respectifly become a dobble consonants ('ðt' -> 'tt')"],
        ["text", "Any 'áa' will collapse to 'á'."],
        ["container", [
            ["title", "U-Mutation"],
            ["text", "Any time a 'u' in an unstressed syllable follows an 'a' in a stressed syllable. It changes 'a' to 'ǫ'.<br>May also appier when there used to be a 'u' in place.<br>When there is an unstressed sylable before the stressed a, the unstressed'a' additionaly mutates into 'u'."]
        ],false],
        ["container", [
            ["title", "I-Mutation"],
            ["text", "<div>'a' -> 'e'<br>'á' -> 'æ'<br>'o' -> 'ø'/'e'/'y'<br>'ó' -> 'ố'<br>'u' -> 'y'<br>'ú' -> 'ý'<br>'jó' -> 'ý'<br>'jú' -> 'ý'<br>'ǫ' -> 'ø'<br>'au' -> 'ey'</div>"]
        ],false]
    ],false],

